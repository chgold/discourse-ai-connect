PORT=3086
BIND=127.0.0.1
RACK_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=discourse_dev
DB_USER=discourse
DB_PASSWORD=change_me_in_production

DISCOURSE_URL=http://localhost:3000
DISCOURSE_API_KEY=
DISCOURSE_API_USER=system
DISCOURSE_AI_CONNECT_URL=http://localhost:8086

ALLOWED_ORIGINS=

RATE_LIMIT_TOOL_PER_MINUTE=50
RATE_LIMIT_TOOL_PER_HOUR=1000
RATE_LIMIT_OAUTH_PER_MINUTE=10
RATE_LIMIT_OAUTH_PER_HOUR=60
RATE_LIMIT_TOKEN_PER_MINUTE=20
RATE_LIMIT_TOKEN_PER_HOUR=200

# Test-only: honoured solely when RACK_ENV=test (and only via the trusted proxy).
DEV_ALLOW_UID_PARAM=0
DISCOURSE_STUB_MODE=0

# Shared secret the Discourse proxy sends as X-AI-Connect-Proxy-Secret.
# Must match the Discourse site setting ai_connect_proxy_secret (or its
# AI_CONNECT_PROXY_SECRET env). Unset = consent/token routes fail closed.
# Generate: openssl rand -hex 32
AI_CONNECT_PROXY_SECRET=
